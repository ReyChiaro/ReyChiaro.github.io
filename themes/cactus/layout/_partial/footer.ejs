<footer id="footer">
  <div class="footer-left">
    <%= __('footer.copyright') %> &copy;
    <% var endYear = (theme.copyright && theme.copyright.end_year) ? theme.copyright.end_year : new Date().getFullYear() %>
    <% var startYear = (theme.copyright && theme.copyright.start_year) ? theme.copyright.start_year : new Date().getFullYear() %>
    <%= startYear >= endYear ? endYear : startYear + "-" + endYear %>
    <%= config.author || config.title %>
  </div>
  <div class="footer-right">
    <nav>
      <ul>
        <% var navigation = site.data.navigation || Object.keys(theme.nav || {}).map(function(key) { return { key: key, label: __('nav.' + key).replace('nav.', ''), url: theme.nav[key] }; }); %>
        <% navigation.forEach(function(item) { %><!--
       --><li><a href="<%- url_for(item.url) %>"><%= item.label || __('nav.' + item.key).replace('nav.', '') %></a></li><!--
     --><% }); %>
      </ul>
    </nav>
  </div>
</footer>
