#header
  position: fixed
  top: 1rem
  left: 1rem
  z-index: 1000
  width: auto
  max-width: calc(100vw - 2rem)
  margin: 0

  .site-header__inner
    display: flex
    align-items: center
    min-height: 3.55rem
    padding: .3rem
    border: 1px solid rgba(222, 210, 232, .85)
    border-radius: 1.15rem
    background: rgba(255, 255, 255, .9)
    box-shadow: 0 12px 36px rgba(89, 63, 105, .09)
    backdrop-filter: blur(18px)
    -webkit-backdrop-filter: blur(18px)
    transition: background-color .24s ease, border-color .24s ease, box-shadow .24s ease

  a
    background: none
    color: inherit
    text-decoration: none

  #site-nav-toggle
    position: relative
    display: inline-flex
    flex: 0 0 auto
    align-items: center
    justify-content: center
    width: 2.95rem
    height: 2.95rem
    padding: 0
    overflow: hidden
    border: 2px solid rgba(190, 146, 216, .48)
    border-radius: 50%
    background: linear-gradient(145deg, rgba(234, 218, 248, .95), rgba(250, 220, 237, .9))
    box-shadow: 0 5px 16px rgba(123, 86, 145, .14)
    color: $color-accent-1
    cursor: pointer
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease

    &:after
      position: absolute
      inset: 2px
      border: 1px solid rgba(255, 255, 255, .72)
      border-radius: 50%
      content: ""
      pointer-events: none

    &:hover
      border-color: rgba(182, 95, 145, .58)
      box-shadow: 0 7px 20px rgba(123, 86, 145, .2)
      transform: translateY(-1px)

    &:focus-visible
      outline: 2px solid rgba(154, 107, 196, .6)
      outline-offset: 3px

  #logo
    display: block
    width: 100%
    height: 100%
    border-radius: 50%
    object-fit: cover

  .site-avatar-fallback
    font-size: 1.25rem
    font-weight: 700

  .site-header__panel
    display: flex
    align-items: center
    max-width: 44rem
    margin-left: .35rem
    overflow: hidden
    opacity: 1
    white-space: nowrap
    transform: translateX(0)
    transition: max-width .3s ease, margin .3s ease, opacity .18s ease, transform .3s ease

  .site-brand
    display: inline-flex
    flex: 0 0 auto
    align-items: center
    padding: .45rem .65rem
    color: $color-text

    &:hover
      color: $color-accent-1

  #title
    letter-spacing: .025em
    font-size: 1.02rem
    font-weight: 700
    line-height: 1
    transition: color .2s ease

  #nav
    flex: 1 1 auto

    ul
      display: flex
      align-items: center
      gap: .08rem
      margin: 0
      padding: 0 .18rem 0 .35rem
      border-left: 1px solid $color-border
      list-style: none

    li
      margin: 0

    a
      display: block
      padding: .56rem .58rem
      border-radius: .62rem
      color: $color-meta
      font-size: .8rem
      letter-spacing: .02em
      line-height: 1
      transition: background-color .18s ease, color .18s ease

      &:hover
        background: rgba(155, 111, 196, .09)
        color: $color-accent-1

      &:focus-visible
        outline: 2px solid rgba(154, 107, 196, .55)
        outline-offset: 1px

  &.nav-collapsed
    .site-header__inner
      border-color: transparent
      background: transparent
      box-shadow: none
      backdrop-filter: none
      -webkit-backdrop-filter: none

    .site-header__panel
      max-width: 0
      margin-left: 0
      opacity: 0
      pointer-events: none
      transform: translateX(-.5rem)

body > .content
  transition: padding-top .3s ease

body.site-nav-expanded > .content
  padding-top: 6.25rem

@media screen and (min-width: 72rem)
  #header
    left: calc((100vw - 48rem) / 2 - 5.25rem)

@media screen and (max-width: 680px)
  #header
    top: .65rem
    left: .65rem
    max-width: calc(100vw - 1.3rem)

    .site-header__inner
      align-items: flex-start
      border-radius: 1rem

    #site-nav-toggle
      width: 2.75rem
      height: 2.75rem

    .site-header__panel
      flex-wrap: wrap
      width: calc(100vw - 4.7rem)
      max-width: calc(100vw - 4.7rem)
      white-space: normal

    .site-brand
      min-height: 2.75rem
      padding: .45rem .5rem

    #nav
      flex: 0 0 100%

      ul
        flex-wrap: wrap
        gap: .05rem
        padding: .3rem 0 .05rem .25rem
        border-top: 1px solid $color-border
        border-left: 0

      a
        padding: .52rem .52rem

    &.nav-collapsed .site-header__panel
      width: 0
      max-width: 0

  body.site-nav-expanded .content
    padding-top: 7.75rem

@media (prefers-reduced-motion: reduce)
  #header .site-header__inner,
  #header #site-nav-toggle,
  #header .site-header__panel,
  body > .content
    transition: none

@media print
  #header
    position: static

  #header #site-nav-toggle
    display: none

  #header.nav-collapsed .site-header__panel
    max-width: none
    margin-left: 0
    opacity: 1
    transform: none
