// Fonts
$font-family-body = "LXGW WenKai", "Kaiti SC", "STKaiti", serif
$font-family-mono = "Menlo", "Monaco", "Courier New", monospace
$font-size = 18px
$line-height = 1.72
$page-width = 0rem + (hexo-config("page_width") || 39)
// Logo
$logo-width = 0px + (hexo-config("logo.width") || 0)
$logo-height = 0px + (hexo-config("logo.height") || 0)
// Chiaro is intentionally a light-only theme.
$colors = "chiaro"
