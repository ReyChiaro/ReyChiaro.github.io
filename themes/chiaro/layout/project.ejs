<article class="post project" itemscope itemtype="https://schema.org/CreativeWork">
  <header>
    <h1 class="posttitle" itemprop="name"><%- page.title %></h1>
    <% if (page.summary) { %><p class="project-summary"><%- page.summary %></p><% } %>
    <% if (page.repository || page.demo) { %>
      <p class="project-links">
        <% if (page.repository) { %><a href="<%- page.repository %>">Repository</a><% } %>
        <% if (page.repository && page.demo) { %><span aria-hidden="true"> · </span><% } %>
        <% if (page.demo) { %><a href="<%- page.demo %>">Demo</a><% } %>
      </p>
    <% } %>
  </header>
  <div class="content" itemprop="description">
    <%- page.content %>
  </div>
</article>
